# Copia este archivo como  .env  y rellena tu token de Apify.
# (El archivo .env NO se sube a git — contiene tu token.)

# --- Apify (para la BÚSQUEDA de anuncios) ---
# Tu token: https://console.apify.com/account/integrations
APIFY_TOKEN=pon-aqui-tu-token-de-apify
APIFY_ACTOR=curious_coder~facebook-ads-library-scraper
# Costo en USD por anuncio que cobra el actor (PAY_PER_EVENT)
APIFY_COST_PER_RESULT=0.00075

# --- Cooldown: días dentro de los cuales avisa "ya scrapeaste este término" ---
COOLDOWN_DAYS=12

# --- Máximo de anuncios acumulados por nicho ---
POOL_MAX=3000

# --- Auto-limpieza de videos descargados (horas; Seleccionados se conservan) ---
VIDEO_TTL_HOURS=72

# --- Whisper LOCAL (TRANSCRIPCIÓN, gratis, corre en tu PC) ---
# Modelos: tiny | base | small | medium | large-v3   (small = buen balance)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
